<Window x:Class="LockRun.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lock &amp; Run" Height="580" Width="920"
        MinHeight="520" MinWidth="760"
        Background="#F6F7F9">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Lock &amp; Run"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#20242A" />
                <TextBlock Text="Lock your PC. Keep jobs awake. Check what ran while you were away."
                           Margin="0,6,0,0"
                           Foreground="#5E6673" />
            </StackPanel>
            <Button x:Name="AwayModeButton"
                    DockPanel.Dock="Right"
                    Width="180"
                    Height="44"
                    Margin="24,0,0,0"
                    Click="AwayModeButton_Click"
                    Content="Away Mode Start"
                    FontWeight="SemiBold" />
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,22,0,14"
                Padding="14"
                BorderBrush="#D8DEE8"
                BorderThickness="1"
                Background="White"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StatusTextBlock"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#20242A"
                               Text="Ready" />
                    <TextBlock x:Name="ConfiguredProcessesTextBlock"
                               Margin="0,6,0,0"
                               Foreground="#5E6673"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="132"
                        Height="36"
                        Margin="20,0,0,0"
                        Click="RefreshButton_Click"
                        Content="Refresh" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    Background="White"
                    CornerRadius="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="14,12,14,8"
                               Text="Monitored processes currently running"
                               FontWeight="SemiBold"
                               Foreground="#20242A" />
                    <ListView x:Name="ProcessListView"
                              Margin="8,0,8,8">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="140" />
                                <GridViewColumn Header="PID" DisplayMemberBinding="{Binding ProcessId}" Width="80" />
                                <GridViewColumn Header="Started" DisplayMemberBinding="{Binding StartedAtText}" Width="150" />
                                <GridViewColumn Header="Window" DisplayMemberBinding="{Binding MainWindowTitle}" Width="260" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="16,0,0,0"
                    Padding="14"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    Background="White"
                    CornerRadius="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Latest report"
                               FontWeight="SemiBold"
                               Foreground="#20242A" />
                    <TextBox x:Name="ReportTextBox"
                             Margin="0,10,0,0"
                             BorderThickness="0"
                             Background="#F6F7F9"
                             Padding="10"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             Text="No away session has completed yet." />
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,14,0,0"
                   Foreground="#5E6673"
                   Text="Closing the window keeps Lock &amp; Run in the tray. Use the tray menu to exit." />
    </Grid>
</Window>
