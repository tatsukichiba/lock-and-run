<Window x:Class="LockRun.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add running processes"
        Width="720"
        Height="620"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7F9">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingTextBlock"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#20242A"
                   Text="Add running processes" />

        <TextBlock x:Name="DescriptionTextBlock"
                   Grid.Row="1"
                   Margin="0,7,0,18"
                   Foreground="#5E6673"
                   TextWrapping="Wrap"
                   Text="Select running processes to add to monitoring." />

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SearchLabelTextBlock"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="Search" />
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     Height="34"
                     Padding="8,4"
                     TextChanged="SearchTextBox_TextChanged" />
            <TextBlock x:Name="CandidateCountTextBlock"
                       Grid.Column="2"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#5E6673" />
        </Grid>

        <Border Grid.Row="3"
                BorderBrush="#D8DEE8"
                BorderThickness="1"
                Background="White"
                CornerRadius="8">
            <ListView x:Name="CandidateListView" Margin="8">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="44">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="NameColumn"
                                        Header="Name"
                                        DisplayMemberBinding="{Binding Name}"
                                        Width="180" />
                        <GridViewColumn x:Name="CountColumn"
                                        Header="Count"
                                        DisplayMemberBinding="{Binding InstanceCount}"
                                        Width="70" />
                        <GridViewColumn x:Name="WindowColumn"
                                        Header="Window"
                                        DisplayMemberBinding="{Binding MainWindowTitle}"
                                        Width="350" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="4"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="CancelButton"
                    Width="110"
                    Height="38"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Content="Cancel" />
            <Button x:Name="AddButton"
                    Width="140"
                    Height="38"
                    IsDefault="True"
                    Click="AddButton_Click"
                    Content="Add selected" />
        </StackPanel>
    </Grid>
</Window>
